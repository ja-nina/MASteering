{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "run_games: config (1 episode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_games.py",
            "args": ["--config", "${input:configPath}", "--episodes", "1"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "inputs": [
        {
            "id": "configPath",
            "type": "promptString",
            "description": "Run config (generate with scripts/make_configs.py)",
            "default": "config/runs/smoke/gbs_3p/gbs_3p__none.yaml"
        }
    ]
}

# Default: normalise all text files to LF
* text=auto eol=lf

# ── Git LFS — large generated files ──────────────────────────────────────────
# Episode logs and traces (can be 100s of MB per run)
logs/**/*.jsonl           filter=lfs diff=lfs merge=lfs -text
logs/**/*.summary.json    filter=lfs diff=lfs merge=lfs -text
logs/**/*.trace.txt       filter=lfs diff=lfs merge=lfs -text
# Steering vectors and activations
vectors/**/*.npy          filter=lfs diff=lfs merge=lfs -text
activations/**/*.npy      filter=lfs diff=lfs merge=lfs -text
saes/**                   filter=lfs diff=lfs merge=lfs -text
# ── Explicitly NOT LFS — source files always stored normally ─────────────────
*.py                      text eol=lf
*.yaml                    text eol=lf
*.yml                     text eol=lf
*.sh                      text eol=lf
*.md                      text eol=lf
*.json                    text eol=lf
*.txt                     text eol=lf
*.slurm                   text eol=lf
logs/**/*.summary.json !text !filter !merge !diff
